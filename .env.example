# Fit4Job environment configuration. Copy to .env and fill in values.
APP_NAME=Fit4Job
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Google Gemini (RAG / generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase / Firestore
FIREBASE_PROJECT_ID=fit4job-b87dc
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIRESTORE_DATABASE_ID=(default)

# Model artifacts (drop your trained files into models_store/)
SBERT_MODEL_PATH=models_store/sbert
PCA_MODEL_PATH=models_store/pca_model.pkl
FAISS_INDEX_PATH=models_store/faiss_hnsw.index
EMBEDDING_DIM=384
REDUCED_DIM=128

# Hybrid scoring weights
SEMANTIC_WEIGHT=0.7
SKILL_WEIGHT=0.3

ADMIN_EMAIL=admin@fit4job.lk
ADMIN_PASSWORD=admin123
